{
    "name": "api-kontal",
    "version": "0.0.2",
    "description": "API do Kontal — gestão financeira e contábil para pequenas empresas e escritórios de contabilidade",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:seed": "node --env-file=.env prisma/seed.mjs",
        "prisma:studio": "prisma studio --browser none",
        "lint": "eslint src/",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check src/**/*.{ts,js,json,md}",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "emulators:start": "firebase emulators:start --only auth,firestore --project demo-kontal",
        "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-kontal \"vitest run --config ./vitest.config.e2e.ts\"",
        "release": "standard-version",
        "commit": "cz",
        "prepare": "husky"
    },
    "dependencies": {
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.0.1",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "dotenv": "^18.0.4",
        "firebase-admin": "^13.10.0",
        "passport": "^0.7.0",
        "passport-custom": "^1.2.1",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/mau": "^0.2.6",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/passport": "^1.0.17",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.0.0",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "@vitest/coverage-v8": "^4.1.2",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9.38.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "firebase-tools": "^15.33.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2",
        "prisma": "^7.4.2",
        "source-map-support": "^0.5.21",
        "standard-version": "^9.5.0",
        "supertest": "^7.0.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.56.1",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.2"
    },
    "lint-staged": {
        "**/*.{ts,js,json,md,yml,yaml,Dockerfile}": "prettier --write"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
